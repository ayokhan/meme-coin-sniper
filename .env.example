# Copy to .env.local and fill in. Never commit real secrets.

# — Auth (NextAuth)
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
OWNER_EMAIL=
OWNER_WALLET_ADDRESSES=

# — Database
DATABASE_URL=

# — Subscription / payment (Solana USDC)
# For reliable verification under load, use a dedicated RPC (e.g. Helius paid tier
# or another provider). Set SOLANA_RPC_URL, or HELIUS_API_KEY as fallback.
SOLANA_RPC_URL=
# HELIUS_API_KEY=
SOLANA_PAYMENT_WALLET=
# SOLANA_USDC_MINT=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v

# — APIs (optional per feature)
# ANTHROPIC_API_KEY=
# MORALIS_API_KEY=
# HELIUS_API_KEY=
# BIRDEYE_API_KEY=
# APIFY_API_TOKEN=
# RESEND_API_KEY=
# RESEND_FROM=
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# TELEGRAM_SIGNALS_CHANNEL_ID=

# — Cron / internal
CRON_SECRET=
# NEXT_PUBLIC_APP_URL=
# VERCEL_URL= (set by Vercel)

# — Trading / exchange (optional)
# BLOFIN_API_KEY= BLOFIN_SECRET_KEY= BLOFIN_PASSPHRASE=
# KUCOIN_FUTURES_API_KEY= KUCOIN_FUTURES_SECRET= KUCOIN_FUTURES_PASSPHRASE=
# HYPERLIQUID_PRIVATE_KEY=
# ENCRYPTION_KEY=
