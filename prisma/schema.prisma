generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Token {
  id              String   @id @default(cuid())
  contractAddress String   @unique
  symbol          String
  name            String
  chain           String
  source          String?  @default("dexscreener") // birdeye | moralis | dexscreener | twitter
  
  dexId           String?
  pairAddress     String?
  
  marketCap       Float?
  liquidity       Float?
  volume24h       Float?
  priceUSD        Float?
  priceChange24h  Float?
  
  viralScore      Int      @default(0)
  scoreBreakdown  Json?
  
  isHoneypot      Boolean  @default(false)
  mintAuthority   Boolean  @default(false)
  freezeAuthority Boolean  @default(false)
  topHolderPct    Float?
  securityData    Json?
  
  website         String?
  twitter         String?
  telegram        String?
  discord         String?
  
  launchedAt      DateTime
  firstSeenAt     DateTime @default(now())
  lastUpdatedAt   DateTime @updatedAt
  
  @@index([chain])
  @@index([viralScore])
  @@index([firstSeenAt])
}

model ScanLog {
  id          String   @id @default(cuid())
  chain       String
  tokensFound Int
  scanTime    DateTime @default(now())
  
  @@index([scanTime])
}

/** Tracks first-seen perp symbols for "Hot New Perps" (new listings in last 7 days). */
model KnownPerpSymbol {
  symbol      String   @id
  firstSeenAt DateTime @default(now())
}

/** Perp alerts: notify when condition is met (new listing, 5m % above/below threshold). Subscribers only; limits by tier. */
model PerpAlert {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  symbol          String?   // null for new_listing (any new perp)
  alertType       String    // new_listing | 5m_pct_above | 5m_pct_below
  threshold       Float?    // for 5m_pct_above / 5m_pct_below
  channel         String    @default("telegram")
  lastTriggeredAt DateTime?
  createdAt       DateTime  @default(now())
  @@index([userId])
  @@index([alertType])
}

// Auth & subscriptions
model User {
  id            String    @id @default(cuid())
  email         String?   @unique
  emailVerified DateTime?
  name          String?
  image         String?
  hashedPassword String?
  walletAddress String?   @unique  // Solana wallet for wallet-based login
  phone         String?
  country       String?
  experienceTradingCrypto String?  // e.g. beginner | intermediate | expert
  tradingBotOnDemand     Boolean  @default(false)  // owner can enable Trading Bot access for VIP users on request
  polymarketBotOnDemand  Boolean  @default(false)  // owner can enable Nova Polymarket Bot access for VIP users on request
  propFirmBotOnDemand    Boolean  @default(false)  // owner can enable Nova Prop Firm Bot access for VIP users on request
  novaUltimateOnDemand   Boolean  @default(false)  // owner can enable Nova Ultimate (meme sniper / terminal) for VIP users on request
  /** Owner-only toggle: allow VIP users to access CT Scan (Twitter tracker) on demand. */
  ctScanOnDemand         Boolean  @default(false)
  /** When set, CT Scan on-demand access expires at this time (null = no extra expiry beyond subscription). */
  ctScanOnDemandExpiresAt DateTime?
  /** Owner-only toggle: allow VIP users to access Meme Coins Traders (Wallet Tracker → Meme) on demand. */
  memeCoinsTraderOnDemand Boolean  @default(false)
  /** When set, Meme Coins Traders on-demand access expires at this time (null = no extra expiry beyond subscription). */
  memeCoinsTraderOnDemandExpiresAt DateTime?
  /** Opt-in at registration: receive NovaStaris newsletter / perp digest when admin enables "Send digest to newsletter subscribers". */
  newsletterOptIn       Boolean  @default(false)
  /** NovaConnect social portal: opt-in and profile fields. */
  novaConnectOptIn      Boolean  @default(true)
  novaConnectEnabled    Boolean  @default(true)
  novaConnectDisplayName String?
  novaConnectAvatarUrl   String?
  /** Presence preference: online | away | busy | offline (used with last-seen). */
  novaConnectStatus      String   @default("online")

  /** When user first accepted NovaConnect rules (for admin visibility). */
  novaConnectRulesAcceptedAt DateTime?
  /** Set by admin: can delete community posts (moderation). */
  novaConnectCommunityRep    Boolean  @default(false)
  /** Set by admin: allow NovaConnect (online list, DMs) even if not Pro/VIP. */
  novaConnectAllowedByAdmin  Boolean  @default(false)
  /** Set by owner/admin: coach user gets VIP-level app access + can publish coach calls (not admin pages). */
  coachUser                  Boolean  @default(false)
  /** When user accepted Payment Terms and Conditions (required before any subscription payment). */
  paymentTermsAcceptedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  accounts      Account[]
  subscriptions Subscription[]
  pinnedTokens  PinnedToken[]
  novaInvestmentAgentPortfolioPins NovaInvestmentAgentPortfolioPin[]
  userTelegram  UserTelegram?
  aiAnalysisFeedbacks AiAnalysisFeedback[]
  novaSmartFeedbacks  NovaSmartFeedback[]
  novaFiveMinsOwnerFeedbacks NovaFiveMinsOwnerFeedback[]
  passwordResets PasswordResetToken[]
  userLeverageWallets  UserLeverageWallet[]
  userPolymarketTrackedWallets UserPolymarketTrackedWallet[]
  userMemeCoinWallets  UserMemeCoinWallet[]
  userBlofinConfig     UserBlofinConfig?
  tradingBotJournalEntries TradingBotJournalEntry[]
  userPolymarketConfig UserPolymarketConfig?
  perpAlerts           PerpAlert[]
  /** Eligible (e.g. VIP) users can set 2–5; alert when this many tracked wallets buy same token. */
  walletTrackerMinBuyers Int?
  usageThisMonth      UsageThisMonth[]
  novaConnectPresence NovaConnectPresence?
  novaConnectMessagesSent NovaConnectMessage[] @relation("NovaConnectFromUser")
  novaConnectMessagesReceived NovaConnectMessage[] @relation("NovaConnectToUser")
  novaConnectBlocksInitiated NovaConnectBlock[] @relation("NovaConnectBlocksInitiated")
  novaConnectBlocksReceived  NovaConnectBlock[] @relation("NovaConnectBlocksReceived")
  novaConnectReportsFiled    NovaConnectReport[] @relation("NovaConnectReportsFiled")
  novaConnectReportsAgainst  NovaConnectReport[] @relation("NovaConnectReportsAgainst")
}

// Per-user usage counts for current month (AI analyses; alerts are counted from UserMemeCoinAlert + LeverageAlert)
model UsageThisMonth {
  id         String   @id @default(cuid())
  userId     String
  monthKey   String   // e.g. "2026-02"
  aiAnalyses Int      @default(0)
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, monthKey])
  @@index([userId])
}

// Per-user Blofin API keys (encrypted at rest). When set, trading bot uses these for that user.
/** User trading journal — closed trades, NovaRadar snapshots, manual notes. */
model TradingBotJournalEntry {
  id                   String    @id @default(cuid())
  userId               String
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /** Blofin fill/order id for dedup when syncing closed trades */
  externalId           String?
  source               String    @default("manual") // manual | closed_trade | nova_radar
  instId               String?
  symbol               String
  side                 String    // long | short
  entryPrice           Float
  exitPrice            Float?
  takeProfitPrice      Float?
  stopLossPrice        Float?
  leverage             Int?
  positionNotionalUsdt Float?
  realizedPnlUsdt      Float?
  roiPct               Float?
  outcome              String    @default("open") // win | loss | breakeven | open
  blofinMode           String?   // demo | live
  novaRadarSnapshot    String?   // JSON
  notes                String?
  closedAt             DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@unique([userId, externalId])
  @@index([userId, createdAt(sort: Desc)])
}

model UserBlofinConfig {
  id                   String   @id @default(cuid())
  userId               String   @unique
  encryptedApiKey      String   // AES-256-GCM encrypted
  encryptedSecretKey   String
  encryptedPassphrase  String
  demoMode             Boolean  @default(true)
  brokerId             String?
  updatedAt            DateTime @updatedAt
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}

// Per-user Polymarket CLOB L2 API credentials (encrypted at rest).
model UserPolymarketConfig {
  id                  String   @id @default(cuid())
  userId              String   @unique
  address             String   // POLY_ADDRESS (0x...)
  encryptedApiKey     String
  encryptedPassphrase String
  encryptedSecret     String
  updatedAt           DateTime @updatedAt
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@index([token])
  @@index([userId])
  @@index([expiresAt])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Subscription {
  id                String   @id @default(cuid())
  userId            String
  tier              String   @default("vip")  // "pro" | "vip"
  plan              String   // e.g. "1month", "6month", "12month" (pro) or "1day", "1month", "6month", "12month" (vip)
  amountUsd         Int
  expiresAt         DateTime
  txSignature       String?  // Solana tx signature for USDC verification
  stripeSessionId   String?  // Stripe Checkout session id (card payments); idempotent webhook
  createdAt         DateTime @default(now())
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([stripeSessionId])
  @@index([userId])
  @@index([expiresAt])
}

// Admin-managed tracked wallets for Wallet Tracker (3+ wallets buy same coin → alert)
model TrackedWallet {
  id              String   @id @default(cuid())
  address         String   @unique
  label           String?
  active          Boolean  @default(true)  // when false, wallet is temporarily excluded from tracking (not removed)
  firstBuyEnabled Boolean  @default(true) // when true, first-buy alerts fire when this wallet buys a token for the first time
  global          Boolean  @default(true) // when true, wallet appears on global meme coin tracking for all users
  createdAt       DateTime @default(now())
  @@index([address])
}

// Admin-managed alert rules (e.g. min wallets that must buy same coin to trigger alert)
model AlertRule {
  id        String   @id @default(cuid())
  key       String   @unique // "wallet_tracker"
  minBuyers Int      @default(3)
  maxAgeHours Int    @default(24)
  maxAlerts Int      @default(30)
  updatedAt DateTime @updatedAt
}

// Wallet Tracker: avoid sending same alert to Telegram repeatedly
model WalletAlertSent {
  id              String   @id @default(cuid())
  contractAddress String
  sentAt          DateTime @default(now())
  @@index([contractAddress])
  @@index([sentAt])
}

// Polymarket Tracker: Polygon proxy wallets (0x) trading on Polymarket. Admin-curated list + per-user adds (VIP).
model PolymarketTrackedWallet {
  id        String   @id @default(cuid())
  address   String   @unique
  nickname  String?
  active    Boolean  @default(true)
  global    Boolean  @default(true)
  createdAt DateTime @default(now())
  @@index([active])
  @@index([global])
}

model UserPolymarketTrackedWallet {
  id        String   @id @default(cuid())
  userId    String
  address   String
  nickname  String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, address])
  @@index([userId])
}

// Leverage Wallet Tracker: Hyperliquid/EVM wallets (Top Leverage Traders). Admin can add, nickname, activate, alert.
model LeverageWallet {
  id           String   @id @default(cuid())
  address      String   @unique  // 0x... EVM address (Hyperliquid)
  nickname     String?
  active       Boolean  @default(true)
  alertEnabled Boolean  @default(false)  // when true, send Telegram alert on new trade
  global       Boolean  @default(true)   // when true, appears on global Top Leverage Traders for all users
  createdAt    DateTime @default(now())
  @@index([address])
  @@index([active])
}

// Per-user leverage wallets (no limit). In-app alerts only.
model UserLeverageWallet {
  id           String   @id @default(cuid())
  userId       String
  address      String   // 0x... EVM (Hyperliquid)
  nickname     String?
  alertEnabled Boolean  @default(true)
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, address])
  @@index([userId])
}

// Per-user meme coin wallets (max 5). In-app first-buy alerts only.
model UserMemeCoinWallet {
  id        String   @id @default(cuid())
  userId    String
  address   String   // Solana or BSC wallet
  label     String?
  chain     String   @default("solana")  // "solana" | "bsc"
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, address])
  @@index([userId])
}

// In-app first-buy alerts for user's meme coin wallets (one per user+wallet+token)
model UserMemeCoinAlert {
  id              String   @id @default(cuid())
  userId          String
  walletAddress   String
  contractAddress String
  symbol          String?
  createdAt       DateTime @default(now())
  @@unique([userId, walletAddress, contractAddress])
  @@index([userId])
  @@index([createdAt])
}

// Last known positions snapshot per leverage wallet (for new-trade alert diff)
model LeverageWalletSnapshot {
  id           String   @id @default(cuid())
  walletAddress String  @unique
  positionsJson String  @default("[]")  // JSON array of { coin, side, szi, ... }
  updatedAt    DateTime @updatedAt
  @@index([walletAddress])
}

// In-app recent leverage alerts (when position changes; keep last N). userId set for user-owned wallets.
model LeverageAlert {
  id              String   @id @default(cuid())
  userId          String?  // when set, alert is for this user's wallet
  walletAddress   String
  nickname        String?
  positionsSummary String  // e.g. "SOL long $180 | ETH short $3200"
  createdAt       DateTime @default(now())
  @@index([createdAt])
  @@index([userId])
}

// Owner-only: first time a tracked wallet buys a token (one alert per wallet+token ever)
model WalletFirstBuyAlertSent {
  id              String   @id @default(cuid())
  walletAddress   String
  contractAddress String
  sentAt          DateTime @default(now())
  @@unique([walletAddress, contractAddress])
  @@index([walletAddress])
  @@index([sentAt])
}

// Owner-only feature toggles (e.g. disable Moralis / Telegram during testing)
model FeatureFlag {
  id        String   @id @default(cuid())
  key       String   @unique  // moralis_go_hunting | moralis_wallet_tracker | telegram_wallet_alerts | nova_connect | ...
  enabled   Boolean  @default(true)
  updatedAt DateTime @updatedAt
  @@index([key])
}

// Owner-managed green "NEW" pill on main nav tabs (expiry UTC; null = badge off).
model TabNewBadge {
  tabId     String    @id
  expiresAt DateTime?
  updatedAt DateTime  @updatedAt
}

// Pinned tokens for AI re-analysis every ~3 min (Solana or BSC)
model PinnedToken {
  id              String    @id @default(cuid())
  userId          String
  contractAddress String
  chain           String    @default("solana") // "solana" | "bsc"
  symbol          String?
  name            String?
  pinnedAt        DateTime  @default(now())
  lastAnalyzedAt  DateTime?
  analysisResult  Json?     // { score, signal, reasons, recommendations, tokenInfo, ... }
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, contractAddress])
  @@index([userId])
  @@index([lastAnalyzedAt])
}

// Support tickets (form submissions + from chat when agent offline)
model SupportTicket {
  id            String   @id @default(cuid())
  supportNumber String   @unique  // e.g. NV-SUP-A1B2C3
  title         String
  message       String
  name          String
  email         String
  source        String   @default("form")  // "form" | "chat"
  status        String   @default("new")  // "new" | "pending" | "assigned" | "open" | "resolved"
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt
  @@index([createdAt])
  @@index([status])
}

// Single row (id = "default"): when owner last pinged (agent "online" if within ~2 min)
model AgentPresence {
  id        String   @id  // use "default"
  lastSeenAt DateTime @default(now()) @updatedAt
}

// Chat session: customer conversation with Nja and optionally live agent
model ChatSession {
  id              String   @id @default(cuid())
  status          String   @default("nja")  // "nja" | "live" | "submitted"
  customerName    String?
  customerEmail   String?
  supportTicketId String?
  /// Set when customer is routed to live agent (agent online path only); used for admin alerts.
  liveTransferAt DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  messages        ChatMessage[]
  @@index([status])
  @@index([createdAt])
  @@index([liveTransferAt])
}

model ChatMessage {
  id        String   @id @default(cuid())
  sessionId String
  role      String   // "customer" | "nja" | "agent"
  content   String
  createdAt DateTime @default(now())
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  @@index([sessionId])
}

// NovaConnect: social + trader community chat
model NovaConnectPresence {
  id         String   @id @default(cuid())
  userId     String   @unique
  status     String   @default("online") // online | away | busy | offline
  lastSeenAt DateTime @default(now()) @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([lastSeenAt])
}

model NovaConnectMessage {
  id               String   @id @default(cuid())
  roomType         String   @default("community") // community | dm
  roomId           String?  // reserved for future rooms
  parentMessageId  String?  // for community replies
  fromUserId       String
  toUserId         String?
  content          String
  imageUrl         String?
  createdAt        DateTime @default(now())
  deletedAt        DateTime?
  deletedById      String?
  fromUser         User     @relation("NovaConnectFromUser", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser           User?    @relation("NovaConnectToUser", fields: [toUserId], references: [id])
  parentMessage    NovaConnectMessage?  @relation("Replies", fields: [parentMessageId], references: [id], onDelete: Cascade)
  replies          NovaConnectMessage[] @relation("Replies")
  @@index([roomType, createdAt])
  @@index([fromUserId])
  @@index([toUserId])
  @@index([parentMessageId])
}

model NovaConnectBlock {
  id            String   @id @default(cuid())
  blockerUserId String
  blockedUserId String
  createdAt     DateTime @default(now())
  blocker       User     @relation("NovaConnectBlocksInitiated", fields: [blockerUserId], references: [id], onDelete: Cascade)
  blocked       User     @relation("NovaConnectBlocksReceived", fields: [blockedUserId], references: [id], onDelete: Cascade)
  @@unique([blockerUserId, blockedUserId])
  @@index([blockerUserId])
  @@index([blockedUserId])
}

model NovaConnectReport {
  id             String   @id @default(cuid())
  reporterUserId String
  reportedUserId String
  reason         String
  screenshotUrl  String?
  createdAt      DateTime @default(now())
  reporter       User     @relation("NovaConnectReportsFiled", fields: [reporterUserId], references: [id], onDelete: Cascade)
  reported       User     @relation("NovaConnectReportsAgainst", fields: [reportedUserId], references: [id], onDelete: Cascade)
  @@index([reporterUserId])
  @@index([reportedUserId])
  @@index([createdAt])
}

// Coach Calls: owner-only posts, VIP members can view (CA / call alerts)
model CoachCall {
  id        String   @id @default(cuid())
  title     String?  // optional short title
  authorLabel String? // e.g. "Coach Zaza"
  content   String   // CA details, contract address, notes, etc.
  createdAt DateTime @default(now())
  @@index([createdAt])
}

// User Telegram ID for Coach Calls / group invites (members submit, owner can export)
model UserTelegram {
  id         String   @id @default(cuid())
  userId     String   @unique
  telegramId String   // e.g. @username or numeric id
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}

// App Insights: page views for owner-only analytics (country, city, device, path)
model AnalyticsEvent {
  id         String   @id @default(cuid())
  path       String   // e.g. / or /subscribe
  country    String?  // from Vercel x-vercel-ip-country or similar
  city       String?  // from Vercel x-vercel-ip-city (deployed only)
  deviceType String?  // mobile | desktop | tablet
  browser    String?
  os         String?
  userId     String?  // if logged in
  createdAt  DateTime @default(now())
  @@index([path])
  @@index([country])
  @@index([city])
  @@index([deviceType])
  @@index([createdAt])
}

// Crypto Futures Trading Bot — owner-only; provider: Blofin or Hyperliquid
model TradingBot {
  id               String   @id @default(cuid())
  provider         String   @default("kucoin")     // "blofin" | "hyperliquid" | "kucoin"
  symbol           String   @default("BTC")      // e.g. BTC, ETH
  timeframe        String   @default("15m")      // 1m, 5m, 15m, 1h, 4h, 1D
  leverage         Int      @default(5)
  tpPct            Float    @default(2)          // take profit %
  slPct            Float    @default(1)          // stop loss %
  mode             String   @default("demo")     // demo | live
  marginCurrency   String   @default("USDT")     // USDT | USDC
  marginMode       String   @default("cross")    // cross | isolated
  positionSizeUsdt Float    @default(50)        // target notional in USDT (or USDC); actual may be ≥ due to min contract
  strategy         String   @default("simple")   // simple | indicators | ai | hybrid
  emaPeriod        Int      @default(200)       // for indicators/hybrid
  fastMA           Int      @default(9)         // fast MA for crossover
  slowMA           Int      @default(21)        // slow MA for crossover
  rsiPeriod        Int      @default(14)
  enabled          Boolean  @default(false)
  lastRunAt        DateTime?
  lastError        String?
  lastDecision       String?   // e.g. "no_trade" | "long" | "short"
  lastDecisionMsg    String?   // human-readable: "No signal", "Opened long 0.001 @ 97234", etc.
  lastDecisionReason String?   // e.g. AI reason: "Long: strong support at 95k, RSI oversold"
  monitorSymbols       String?   // comma-separated instIds e.g. "ETH-USDT,BTC-USDT"; when set, AI monitor only evaluates these
  aiMonitorAutopilot   Boolean   @default(false)  // when true, user can confirm and close from AI Monitor; when false, monitor only suggests (no close)
  /** JSON map instId → take-profit price (user-entered; Blofin often does not surface TP in API). */
  monitorTpTargetsJson String?
  /** JSON `["4H","1D"]` Blofin bar strings for Deep check primary/secondary series. */
  monitorDeepTimeframesJson String?
  aiMonitorRunDeepEachCycle Boolean @default(false)
  aiMonitorDeepCheckAutopilot Boolean @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  @@index([enabled])
}

// NovaScalper — per-user Blofin config (VIP + owner). symbol = base only e.g. BTC; marginCurrency = USDT|USDC.
model NovaScalperConfig {
  id               String   @id @default(cuid())
  userId           String?
  /** 1-based slot per user: Config 1, Config 2, … for parallel contracts. */
  slot             Int      @default(1)
  enabled          Boolean  @default(false)
  /** When true (set by owner in Admin → NovaScalper), user cannot turn NovaScalper back on from the app until owner clears it. */
  ownerForceOff    Boolean  @default(false)
  mode             String   @default("demo") // demo | live
  symbol           String   @default("BTC")
  marginCurrency   String   @default("USDT")
  marginMode       String   @default("cross") // cross | isolated
  side             String   @default("long") // long | short
  /** cross_down | cross_up — long dip = cross_down (price crosses down through entry); long breakout = cross_up */
  entryTrigger     String   @default("cross_down")
  leverage         Int      @default(5)
  entryPrice       Float
  exitPrice        Float
  stopLossPrice    Float?
  positionSizeUsdt Float    @default(50)
  /** 0 = unlimited repeat cycles */
  maxRounds        Int      @default(0)
  completedRounds  Int      @default(0)
  inPosition       Boolean  @default(false)
  lastRefPrice     Float?
  /** If true, try Blofin TP/SL attach after entry (often unreliable; primary exit is market close at exitPrice). */
  attachTpsl       Boolean  @default(false)
  tpslTpPct        Float?
  tpslSlPct        Float?
  lastTickAt       DateTime?
  lastError        String?
  lastAction       String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  @@unique([userId, slot])
  @@index([userId])
}

// Owner-only feedback on NovaStaris AI token analysis (for improving the model)
model AiAnalysisFeedback {
  id              String   @id @default(cuid())
  contractAddress String   // token CA that was analyzed
  outcome         String   // "good" | "bad"
  note            String?  // optional owner note
  score           Int?     // snapshot of analysis score when feedback was given
  signal          String?  // "buy" | "no_buy"
  userId          String?
  createdAt       DateTime @default(now())
  user            User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  @@index([contractAddress])
  @@index([outcome])
  @@index([createdAt])
}

// Per-user RAG corpus: embedded token analysis summaries (VIP + owner when feature-flagged)
model AiAnalysisEmbedding {
  id              String   @id @default(cuid())
  userId          String?  // scopes retrieval — each user only sees their own history
  contractAddress String
  chain           String   @default("solana")
  symbol          String?
  summaryText     String   @db.Text
  embedding       Json     // number[] from OpenAI text-embedding-3-small
  score           Int?
  signal          String?
  feedbackOutcome String?  // good | bad from AiAnalysisFeedback when stored
  createdAt       DateTime @default(now())
  @@index([contractAddress])
  @@index([userId, createdAt])
}

// Owner-only feedback on NovaSmart Analysis (did the suggestion work?)
model NovaSmartFeedback {
  id        String   @id @default(cuid())
  symbol    String
  strategy  String   // "scalp" | "swing" | "mixed"
  worked    Boolean  // true = worked, false = did not work
  note      String?
  userId    String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  @@index([symbol])
  @@index([worked])
  @@index([createdAt])
}

/** Owner-only: Nova 5 mins / Polymarket-style lean outcome for model training labels. */
model NovaFiveMinsOwnerFeedback {
  id              String   @id @default(cuid())
  createdAt       DateTime @default(now())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  symbolInput     String
  pair            String
  horizonMinutes  Int
  direction       String
  convictionPct   Int?
  tapeRegime      String?
  lastClose       Float?
  benchmarkOpen   Float?
  feed            String?
  outcome         String
  notes           String?
  analysisSummary String?
  @@index([userId])
  @@index([createdAt])
  @@index([outcome])
}

// VIP: Meme Leaderboard cached PnL snapshots per tracked wallet + period.
// Built with free APIs only (Helius free + Dexscreener no-key).
model MemeTraderStats {
  id                   String   @id @default(cuid())
  walletAddress        String
  // Period key: "24h" | "7d" | "30d"
  periodKey            String
  label                String?  // mirror of TrackedWallet.label at compute time
  realizedPnlUsd       Float    @default(0)
  unrealizedHoldingsUsd Float   @default(0)
  totalPnlUsd          Float    @default(0)
  volumeUsd            Float    @default(0)
  tradeCount           Int      @default(0)
  winRatePct           Float?
  biggestWinMint       String?
  biggestWinSymbol     String?
  biggestWinPnlUsd     Float?
  notes                String?  // e.g. "approximation: net SOL flow"
  computedAt           DateTime @default(now())

  @@unique([walletAddress, periodKey])
  @@index([periodKey, totalPnlUsd])
  @@index([periodKey, computedAt])
}

// VIP: Nova Investment Agent portfolio pins + owner feedback (worked/did not work + reason)
model NovaInvestmentAgentPortfolioPin {
  id                       String   @id @default(cuid())
  userId                   String
  baseSymbol               String
  amountUsd                Float
  riskProfitPreset        String
  durationMode             String
  totalExpectedReturnPct  Float
  totalExpectedReturnUsd  Float
  resultJson               Json
  pinnedAt                 DateTime @default(now())
  ownerFeedbackWorked     Boolean?
  ownerFeedbackNote       String?
  ownerFeedbackAt         DateTime?
  user                     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, pinnedAt])
}

/** Admin-tunable Meme Runner filter thresholds per chain (sol | bsc | eth). */
model MemeRunnerSettings {
  chain     String   @id
  config    Json
  updatedAt DateTime @updatedAt
}
